<Window x:Class="VideoProjectManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Project Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Projects Panel -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Projects" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <ListBox ItemsSource="{Binding Projects}" 
                     SelectedItem="{Binding SelectedProject}"
                     Height="300" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Load" Command="{Binding LoadProjectsCommand}" Padding="8,5" Margin="0,0,5,0"/>
                <Button Content="New" Padding="8,5" Margin="0,0,5,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Project Details Panel -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Project Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <TextBlock Text="Title" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ProjectTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

            <TextBlock Text="Description" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="80" VerticalAlignment="Top" AcceptsReturn="True" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Create" Command="{Binding CreateProjectCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="Update" Command="{Binding UpdateProjectCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Padding="10,5" Foreground="Red"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>